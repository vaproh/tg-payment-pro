# Telegram payment bot token from @BotFather (DIFFERENT bot from tg-seller-pro)
BOT_TOKEN=
# Same admin as seller-pro
ADMIN_USER_ID=

# Shared SQLite file. Default points at seller-pro DB (read-only for sales/sellers).
DB_PATH=../tg-seller-pro/data/reddit_accounts.db

# Payment bot's own DB (payment_links, payments tables). Created automatically.
DB_PATH_PAYMENTS=./data/payments.db

# Cashfree (UPI)
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Optional: extra HMAC check on webhook. Leave empty to verify via fetch-status instead.
CASHFREE_WEBHOOK_SECRET=
CASHFREE_NOTIFY_URL=https://your-vps/webhook/cashfree

# Request Network (crypto, USD stablecoin)
RN_CLIENT_ID=
RN_WEBHOOK_SECRET=
# Optional composite destination id "<interopAddr>:<tokenAddress>".
# Leave empty if your Client ID already has a bound payee destination.
RN_DESTINATION_ID=
RN_NOTIFY_URL=https://your-vps/webhook/request

# FX: INR per 1 USD override. Empty = fetch + cache.
INR_PER_USD=

# Webview base URL (FastAPI server). Used by /books to build personal links.
WEBAPP_BASE_URL=https://your-vps/books

TIMEZONE=Asia/Kolkata
